.vercel
.env

# Mirrored brand imagery for brands published via staged uploads. The
# bytes live on Shopify's CDN; these are only a local cache so a rebuild
# does not have to re-download them.
brands/*
!brands/*/
brands/*/*
!brands/*/banner.jpg

# Local design tooling / prototypes — not for production deploy
.impeccable/
.playwright-cli/
prototypes/

# match prototype 備份檔
assets/looks/*.bak
data/*.bak*
__pycache__/

# 對手爬蟲資料（2026-10-22 搬出 repo）
/*_all.json
